Options -Indexes
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:app|config|database|routes|resources|storage|vendor|tests|User\ Interface)(?:/|$) - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|migrate\.php|console\.php|bootstrap\.php|README\.md)$ - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[\s?]) [NC]
RewriteRule ^ - [R=404,L]
RewriteCond %{THE_REQUEST} \s/+public(?:/|[\s?]) [NC]
RewriteRule ^public(?:/|$) - [F,L]
RewriteRule ^public/ - [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^ public/index.php [L,QSA]
