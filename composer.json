{
    "name": "calebgruber/theatre-shop",
    "description": "Show-centric theatre shop management for PHP shared hosting",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "laravel/framework": "^12.0",
        "laravel/fortify": "^1.30",
        "livewire/livewire": "^3.6",
        "dompdf/dompdf": "^3.1",
        "lbuchs/webauthn": "^2.2",
        "setasign/fpdi": "^2.6",
        "setasign/fpdf": "^1.8"
    },
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php tests/run.php",
            "@php tests/framework.php"
        ]
    },
    "config": {"sort-packages": true, "platform": {"php": "8.3.0"}}
}
